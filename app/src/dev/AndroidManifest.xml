<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Dev-flavor manifest overlay.

      DEV uses the public HTTPS tunnel for payment return App Links.
      The tunnel host is provided through the `paymentReturnHost`
      manifest placeholder from `app/build.gradle.kts`.
    -->

    <application
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <!--

              Example:
                https://<ngrok-host>/payments/success?external_reference=...

              Android verifies the host through:
                https://<ngrok-host>/.well-known/assetlinks.json
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${paymentReturnHost}"
                    android:pathPrefix="/payments" />
            </intent-filter>

        </activity>

    </application>

</manifest>
