<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Production payment App Link.

      Redirect URLs:
        https://loresuelvo.com.ar/payments/success?external_reference=...
        https://loresuelvo.com.ar/payments/pending?external_reference=...
        https://loresuelvo.com.ar/payments/failure?external_reference=...

      The `${paymentReturnHost}` placeholder is populated by
      `app/build.gradle.kts` for the prod flavor.
    -->

    <application>

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${paymentReturnHost}"
                    android:pathPrefix="/payments" />
            </intent-filter>

        </activity>

    </application>

</manifest>